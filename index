  },[txns]);
  const reservations = useMemo(()=>
    txns.filter(t=>t.status==='scheduled').sort((a,b)=> new Date(a.timeIn) - new Date(b.timeIn))
  ,[txns]);

  const openRoom = (room) => {
    if(room.status==='occupied'){ setInfoRoom(room); return; }
    setCheckInMode('checkin');
    setCheckInRooms([room.id]);
    setCheckInOpen(true);
  };

  const toggleSelect = (id) => {
    setSelected(s => s.includes(id) ? s.filter(x=>x!==id) : [...s, id]);
  };

  const startMultiCheckIn = () => {
    if(selected.length===0) return;
    setCheckInMode('checkin');
    setCheckInRooms(selected);
    setCheckInOpen(true);
  };

  const openSchedule = () => {
    setCheckInMode('schedule');
    setCheckInRooms([]);
    setCheckInOpen(true);
  };

  const confirmCheckIn = async (txn) => {
    try{
      await dbApi.saveTxn(txn);
      if(txn.status==='scheduled'){
        setCheckInOpen(false);
        pushToast(`Reservation saved for ${txn.guestName} — ${fmtDateTime(txn.timeIn)} · ${txn.ref}`);
        return;
      }
      for(const rid of txn.roomIds){
        const room = rooms.find(r=>r.id===rid);
        await dbApi.saveRoom({
          ...(room||{id:rid, number:rid, rate: dbApi.settings.defaultRate}),
          status:'occupied', txnId: txn.ref, guestName: txn.guestName, timeOut: txn.timeOut,
        });
      }
      setCheckInOpen(false);
      setSelected([]); setSelectMode(false);
      pushToast(`Checked in ${txn.guestName} — ${txn.roomIds.join(', ')} · ${txn.ref}`);
    }catch(e){
      pushToast('Check-in failed. Please try again.', 'error');
    }
  };

  const checkout = async (txn) => {
    try{
      await dbApi.saveTxn({ ...txn, status:'completed', actualTimeOut: new Date().toISOString() });
      for(const rid of txn.roomIds){
        const room = rooms.find(r=>r.id===rid);
        await dbApi.saveRoom({ ...(room||{id:rid, number:rid, rate: dbApi.settings.defaultRate}), status:'vacant', txnId:null, guestName:null, timeOut:null });
      }
      setInfoRoom(null);
      pushToast(`Room ${(txn.roomIds||[]).join(', ')} checked out. Now vacant.`);
    }catch(e){
      pushToast('Checkout failed. Please try again.', 'error');
    }
  };

  const activateReservation = async (txn) => {
    const busy = txn.roomIds.filter(rid => { const r = rooms.find(x=>x.id===rid); return r && r.status==='occupied'; });
    if(busy.length){ pushToast(`Room ${busy.join(', ')} is currently occupied — can't check in yet.`, 'error'); return; }
    try{
      const timeIn = new Date();
      const timeOut = new Date(timeIn.getTime() + Number(txn.hours||0)*3600000).toISOString();
      const nextTxn = { ...txn, timeIn: timeIn.toISOString(), timeOut, status:'active' };
      await dbApi.saveTxn(nextTxn);
      for(const rid of txn.roomIds){
        const room = rooms.find(r=>r.id===rid);
        await dbApi.saveRoom({ ...(room||{id:rid, number:rid, rate: dbApi.settings.defaultRate}), status:'occupied', txnId: txn.ref, guestName: txn.guestName, timeOut });
      }
      pushToast(`${txn.guestName} checked in from reservation — ${txn.roomIds.join(', ')}.`);
    }catch(e){
      pushToast('Could not check in this reservation.', 'error');
    }
  };

  const cancelReservation = async (txn) => {
    try{
      await dbApi.saveTxn({ ...txn, status:'cancelled' });
      pushToast(`Reservation for ${txn.guestName} cancelled.`);
    }catch(e){
      pushToast('Could not cancel reservation.', 'error');
    }
  };

  const changeRoom = async (txn, fromId, toId) => {
    const toRoomObj = rooms.find(r=>r.id===toId);
    if(!toRoomObj || toRoomObj.status!=='vacant'){ pushToast('That room is no longer vacant.', 'error'); return; }
    try{
      const nextRoomIds = (txn.roomIds||[]).map(id=> id===fromId ? toId : id);
      await dbApi.saveTxn({ ...txn, roomIds: nextRoomIds });
      const fromRoomObj = rooms.find(r=>r.id===fromId);
      if(fromRoomObj) await dbApi.saveRoom({ ...fromRoomObj, status:'vacant', txnId:null, guestName:null, timeOut:null });
      await dbApi.saveRoom({ ...toRoomObj, status:'occupied', txnId: txn.ref, guestName: txn.guestName, timeOut: txn.timeOut });
      setInfoRoom(null);
      pushToast(`Moved ${txn.guestName} from Room ${fromId} to Room ${toId}.`);
    }catch(e){
      pushToast('Room change failed. Please try again.', 'error');
    }
  };

  const addRoomToTxn = async (txn, roomId) => {
    const roomObj = rooms.find(r=>r.id===roomId);
    if(!roomObj || roomObj.status!=='vacant'){ pushToast('That room is no longer vacant.', 'error'); return; }
    try{
      const nextRoomIds = [...(txn.roomIds||[]), roomId];
      await dbApi.saveTxn({ ...txn, roomIds: nextRoomIds });
      await dbApi.saveRoom({ ...roomObj, status:'occupied', txnId: txn.ref, guestName: txn.guestName, timeOut: txn.timeOut });
      pushToast(`Room ${roomId} added to ${txn.guestName}'s stay.`);
    }catch(e){
      pushToast('Could not add room. Please try again.', 'error');
    }
  };

  const vacantCount = rooms.filter(r=>r.status==='vacant').length;
  const occupiedCount = rooms.length - vacantCount;

  return (
    <div>
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
        <div className="flex items-center gap-4 text-sm">
          <div className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-full bg-[var(--vacant-bright)]"></span>{vacantCount} vacant</div>
          <div className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-full bg-[var(--occupied-bright)]"></span>{occupiedCount} occupied</div>
        </div>
        <div className="flex items-center gap-2 flex-wrap">
          {selectMode && selected.length>0 && (
            <button onClick={startMultiCheckIn}
              className="focus-ring flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white font-semibold text-sm">
              <LogInIcon size={16}/> Check In Selected ({selected.length})
            </button>
          )}
          <button onClick={openSchedule}
            className="focus-ring flex items-center gap-2 px-4 py-2 rounded-lg border font-semibold text-sm hover:border-[var(--brass-bright)]" style={{borderColor:'var(--line)'}}>
            <CalendarIcon size={16}/> Schedule a Booking
          </button>
          <button onClick={()=>{ setSelectMode(s=>!s); setSelected([]); }}
            className={
              "focus-ring flex items-center gap-2 px-4 py-2 rounded-lg border font-semibold text-sm transition-colors " +
              (selectMode ? "bg-[var(--brass)] border-[var(--brass-bright)] text-white" : "border-[var(--line)] hover:border-[var(--brass-bright)]")
            }>
            <GridIcon size={16}/> Multi-Room Select Mode {selectMode ? 'On' : 'Off'}
          </button>
        </div>
      </div>

      <div className="grid gap-3 sm:gap-4" style={{ gridTemplateColumns: roomGridColumns(rooms.length) }}>
        {rooms.map(room=>(
          <RoomCard key={room.id} room={room} now={now}
            selectMode={selectMode} selected={selected.includes(room.id)}
            onToggleSelect={toggleSelect} onOpen={openRoom}/>
        ))}
      </div>

      {reservations.length>0 && (
        <div className="mt-8">
          <h3 className="font-display text-lg font-semibold mb-3 flex items-center gap-2"><CalendarIcon size={18} style={{color:'var(--brass)'}}/> Upcoming Reservations</h3>
          <div className="space-y-2.5">
            {reservations.map(t=>(
              <div key={t.ref} className="rounded-xl border p-4 flex flex-col sm:flex-row sm:items-center gap-3 justify-between" style={{borderColor:'var(--line)', background:'var(--panel)'}}>
                <div className="min-w-0">
                  <div className="font-semibold truncate">{t.guestName} <span className="font-normal" style={{color:'var(--text-muted-c)'}}>· Room {t.roomIds.join(', ')}</span></div>
                  <div className="text-xs tabular mt-0.5" style={{color:'var(--text-muted-c)'}}>{fmtDateTime(t.timeIn)} · {t.hours}h · {t.ref}</div>
                </div>
                <div className="flex gap-2 shrink-0">
                  <button onClick={()=>activateReservation(t)}
                    className="focus-ring flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white text-xs font-bold">
                    <LogInIcon size={14}/> Check In Now
                  </button>
                  <button onClick={()=>cancelReservation(t)}
                    className="focus-ring flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold text-[var(--overdue-bright)]" style={{borderColor:'var(--line)'}}>
                    <XIcon size={14}/> Cancel
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <GuestInfoModal room={infoRoom} txn={infoRoom ? activeTxnByRoom[infoRoom.id] : null} allRooms={rooms}
        onClose={()=>setInfoRoom(null)} onCheckout={checkout} onChangeRoom={changeRoom} onAddRoom={addRoomToTxn}/>

      <CheckInModal open={checkInOpen} mode={checkInMode} initialRooms={checkInRooms} allRooms={rooms} existingTxns={txns}
        existingRefs={existingRefs} defaultRate={dbApi.settings.defaultRate}
        onClose={()=>setCheckInOpen(false)} onConfirm={confirmCheckIn}/>
    </div>
  );
}

function statusLabel(status){
  return status==='active' ? 'Active' : status==='scheduled' ? 'Scheduled' : status==='cancelled' ? 'Cancelled' : 'Completed';
}
function statusBadgeClasses(status){
  if(status==='active') return "bg-[var(--occupied)]/20 text-[var(--occupied-bright)]";
  if(status==='scheduled') return "bg-[var(--brass)]/20 text-[var(--brass-bright)]";
  if(status==='cancelled') return "bg-[var(--overdue)]/20 text-[var(--overdue-bright)]";
  return "bg-[var(--vacant)]/20 text-[var(--vacant-bright)]";
}

/* ============================== OWNER: LEDGER ============================== */
function Ledger({ dbApi, pushToast }){
  const { txns } = dbApi;
  const [q, setQ] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [paymentFilter, setPaymentFilter] = useState('all');

  const filtered = useMemo(()=>{
    return txns.filter(t=>{
      if(statusFilter!=='all' && t.status!==statusFilter) return false;
      if(paymentFilter!=='all' && t.paymentMethod!==paymentFilter) return false;
      if(q.trim()){
        const hay = `${t.ref} ${t.guestName} ${(t.roomIds||[]).join(' ')}`.toLowerCase();
        if(!hay.includes(q.trim().toLowerCase())) return false;
      }
      return true;
    });
  },[txns, q, statusFilter, paymentFilter]);

  const exportRows = (rows) => rows.map(t=>({
    'Reference #': t.ref,
    'Date & Time In': fmtDateTime(t.timeIn),
    'Date & Time Out': fmtDateTime(t.timeOut),
    'Guest Name': t.guestName,
    'Room(s)': (t.roomIds||[]).join(', '),
    'Duration (hrs)': t.hours,
    'Payment Method': t.paymentMethod,
    'Total Amount': t.totalAmount,
    'Status': t.status === 'active' ? 'Active' : 'Completed',
  }));

  const exportXlsx = () => {
    try{
      const wb = XLSX.utils.book_new();
      const ws = XLSX.utils.json_to_sheet(exportRows(filtered));
      ws['!cols'] = [{wch:20},{wch:20},{wch:20},{wch:20},{wch:12},{wch:12},{wch:16},{wch:14},{wch:12}];
      XLSX.utils.book_append_sheet(wb, ws, 'Transactions');
      const buf = XLSX.write(wb, { bookType:'xlsx', type:'array' });
      browserDownload(`inn-transactions-${new Date().toISOString().slice(0,10)}.xlsx`, buf, 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      pushToast('Spreadsheet exported.');
    }catch(e){
      pushToast('Export failed. Please try again.', 'error');
    }
  };

  const exportCsv = () => {
    try{
      const ws = XLSX.utils.json_to_sheet(exportRows(filtered));
      const csv = XLSX.utils.sheet_to_csv(ws);
      browserDownload(`inn-transactions-${new Date().toISOString().slice(0,10)}.csv`, csv, 'text/csv');
      pushToast('CSV exported.');
    }catch(e){
      pushToast('Export failed. Please try again.', 'error');
    }
  };

  return (
    <div>
      <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-4">
        <div className="relative w-full lg:w-72">
          <SearchIcon size={16} className="absolute left-3 top-1/2 -translate-y-1/2" style={{color:'var(--text-muted-c)'}}/>
          <input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search reference, guest, room…"
            className="focus-ring w-full pl-9 pr-3 py-2 rounded-lg border bg-transparent outline-none text-sm"
            style={{borderColor:'var(--line)'}}/>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <select value={statusFilter} onChange={e=>setStatusFilter(e.target.value)}
            className="focus-ring px-3 py-2 rounded-lg border bg-transparent outline-none text-sm" style={{borderColor:'var(--line)'}}>
            <option value="all" style={{color:'#111'}}>All statuses</option>
            <option value="active" style={{color:'#111'}}>Active</option>
            <option value="scheduled" style={{color:'#111'}}>Scheduled</option>
            <option value="completed" style={{color:'#111'}}>Completed</option>
            <option value="cancelled" style={{color:'#111'}}>Cancelled</option>
          </select>
          <select value={paymentFilter} onChange={e=>setPaymentFilter(e.target.value)}
            className="focus-ring px-3 py-2 rounded-lg border bg-transparent outline-none text-sm" style={{borderColor:'var(--line)'}}>
            <option value="all" style={{color:'#111'}}>All payment methods</option>
            {PAYMENT_METHODS.map(m=> <option key={m} value={m} style={{color:'#111'}}>{m}</option>)}
          </select>
          <button onClick={exportCsv}
            className="focus-ring flex items-center gap-1.5 px-3 py-2 rounded-lg border text-sm font-semibold hover:border-[var(--brass-bright)]" style={{borderColor:'var(--line)'}}>
            <DownloadIcon size={15}/> CSV
          </button>
          <button onClick={exportXlsx}
            className="focus-ring flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white text-sm font-bold">
            <SheetIcon size={15}/> Export to Excel
          </button>
        </div>
      </div>

      <div className="rounded-xl border overflow-hidden" style={{borderColor:'var(--line)'}}>
        <div className="overflow-x-auto">
          <table className="w-full text-sm">
            <thead>
              <tr style={{background:'rgba(201,162,75,.10)'}}>
                {['Reference #','Time In','Time Out','Guest','Room(s)','Hrs','Payment','Amount','Status'].map(h=>(
                  <th key={h} className="text-left font-semibold px-4 py-3 whitespace-nowrap" style={{color:'var(--text-muted-c)'}}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {filtered.length===0 && (
                <tr><td colSpan={9} className="px-4 py-10 text-center" style={{color:'var(--text-muted-c)'}}>No transactions match your filters.</td></tr>
              )}
              {filtered.map(t=>(
                <tr key={t.ref} className="border-t" style={{borderColor:'var(--line)'}}>
                  <td className="px-4 py-3 font-semibold tabular whitespace-nowrap">{t.ref}</td>
                  <td className="px-4 py-3 whitespace-nowrap tabular">{fmtDateTime(t.timeIn)}</td>
                  <td className="px-4 py-3 whitespace-nowrap tabular">{fmtDateTime(t.timeOut)}</td>
                  <td className="px-4 py-3">{t.guestName}</td>
                  <td className="px-4 py-3 tabular">{(t.roomIds||[]).join(', ')}</td>
                  <td className="px-4 py-3 tabular">{t.hours}</td>
                  <td className="px-4 py-3">{t.paymentMethod}</td>
                  <td className="px-4 py-3 tabular font-semibold">{fmtMoney(t.totalAmount)}</td>
                  <td className="px-4 py-3">
                    <span className={"px-2 py-0.5 rounded-full text-xs font-semibold " + statusBadgeClasses(t.status)}>
                      {statusLabel(t.status)}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div className="mt-2 text-xs" style={{color:'var(--text-muted-c)'}}>{filtered.length} of {txns.length} transactions shown.</div>
    </div>
  );
}

/* ============================== OWNER: REPORTS ============================== */
function Reports({ dbApi, pushToast }){
  const { txns, settings } = dbApi;

  const last7 = useMemo(()=>{
    const cutoff = Date.now() - 7*24*3600000;
    return txns.filter(t=> new Date(t.createdAt||t.timeIn).getTime() >= cutoff);
  },[txns]);

  const totalRevenue7 = last7
    .filter(t=> t.status!=='scheduled' && t.status!=='cancelled')
    .reduce((s,t)=> s + (Number(t.totalAmount)||0), 0);

  const generateNow = () => {
    try{
      const ws = XLSX.utils.json_to_sheet(last7.map(t=>({
        'Reference #': t.ref, 'Time In': fmtDateTime(t.timeIn), 'Time Out': fmtDateTime(t.timeOut),
        'Guest': t.guestName, 'Room(s)': (t.roomIds||[]).join(', '), 'Hrs': t.hours,
        'Payment': t.paymentMethod, 'Amount': t.totalAmount, 'Status': t.status,
      })));
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Last 7 Days');
      const buf = XLSX.write(wb, { bookType:'xlsx', type:'array' });
      browserDownload(`weekly-report-${new Date().toISOString().slice(0,10)}.xlsx`, buf, 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      pushToast('Weekly report generated.');
    }catch(e){
      pushToast('Report generation failed.', 'error');
    }
  };

  return (
    <div className="space-y-6">
      <div className="grid sm:grid-cols-3 gap-4">
        <div className="rounded-xl border p-5" style={{borderColor:'var(--line)'}}>
          <div className="text-xs uppercase tracking-wide font-semibold" style={{color:'var(--text-muted-c)'}}>Transactions, last 7 days</div>
          <div className="font-display text-3xl font-semibold mt-1 tabular">{last7.length}</div>
        </div>
        <div className="rounded-xl border p-5" style={{borderColor:'var(--line)'}}>
          <div className="text-xs uppercase tracking-wide font-semibold" style={{color:'var(--text-muted-c)'}}>Revenue, last 7 days</div>
          <div className="font-display text-3xl font-semibold mt-1 tabular">{fmtMoney(totalRevenue7)}</div>
        </div>
        <div className="rounded-xl border p-5" style={{borderColor:'var(--line)'}}>
          <div className="text-xs uppercase tracking-wide font-semibold" style={{color:'var(--text-muted-c)'}}>Report recipient{(settings.recipientEmails||[]).length ? 's' : ''}</div>
          <div className="text-sm font-semibold mt-1 leading-snug">{[settings.ownerEmail, ...(settings.recipientEmails||[])].filter(Boolean).join(', ')}</div>
        </div>
      </div>

      <div className="rounded-xl border p-5" style={{borderColor:'var(--line)'}}>
        <div className="flex items-start gap-3">
          <div className="p-2 rounded-lg bg-[var(--brass)]/15 text-[var(--brass-bright)]"><MailIcon size={20}/></div>
          <div className="flex-1">
            <div className="font-display text-lg font-semibold">Automated weekly email report</div>
            <p className="text-sm mt-1" style={{color:'var(--text-muted-c)'}}>
              In production, a Supabase Edge Function runs on a weekly schedule, packages the past 7 days of
              transactions into a spreadsheet, and emails it to <strong>{[settings.ownerEmail, ...(settings.recipientEmails||[])].filter(Boolean).join(', ')}</strong> via the Resend API.
              This browser demo can't dispatch real email or run a server-side cron job — use the button below to generate
              the same report on demand, and see the downloadable source bundle for the deployable Edge Function.
            </p>
            <button onClick={generateNow}
              className="focus-ring mt-3 flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white font-semibold text-sm">
              <DownloadIcon size={16}/> Generate Last-7-Days Report Now
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

/* ============================== OWNER: ADMIN SETTINGS ============================== */
function AdminSettings({ dbApi, pushToast }){
  const { rooms, settings } = dbApi;
  const [form, setForm] = useState(settings);
  const [newRoom, setNewRoom] = useState({ number:'', rate: settings.defaultRate||180 });
  const [newRecipient, setNewRecipient] = useState('');

  useEffect(()=> setForm(settings), [settings]);

  const addRecipient = () => {
    const email = newRecipient.trim();
    if(!email){ return; }
    if(!/^\S+@\S+\.\S+$/.test(email)){ pushToast('Enter a valid email address.', 'error'); return; }
    const list = form.recipientEmails||[];
    if(email===form.ownerEmail || list.includes(email)){ pushToast('That email is already added.', 'error'); return; }
    setForm(f=>({...f, recipientEmails:[...list, email]}));
    setNewRecipient('');
  };
  const removeRecipient = (email) => {
    setForm(f=>({...f, recipientEmails:(f.recipientEmails||[]).filter(e=>e!==email)}));
  };

  const saveSettings = async () => {
    try{
      await dbApi.saveSettings(form);
      pushToast('Settings saved.');
    }catch(e){ pushToast('Could not save settings.', 'error'); }
  };

  const updateRoomRate = async (room, rate) => {
    await dbApi.saveRoom({ ...room, rate: Number(rate)||0 });
  };

  const removeRoom = async (room) => {
    if(room.status==='occupied'){ pushToast('Cannot remove an occupied room.', 'error'); return; }
    await dbApi.deleteRoom(room.id);
    pushToast(`Room ${room.number} removed.`);
  };

  const addRoom = async () => {
    const number = newRoom.number.trim();
    if(!number){ pushToast('Enter a room number.', 'error'); return; }
    if(rooms.some(r=>r.id===number)){ pushToast('That room number already exists.', 'error'); return; }
    await dbApi.saveRoom({ id:number, number, rate:Number(newRoom.rate)||settings.defaultRate, status:'vacant', txnId:null, guestName:null, timeOut:null });
    setNewRoom({ number:'', rate: settings.defaultRate });
    pushToast(`Room ${number} added.`);
  };

  return (
    <div className="space-y-8">
      <section>
        <h3 className="font-display text-lg font-semibold mb-3">Rooms &amp; hourly rates</h3>
        <div className="rounded-xl border overflow-hidden" style={{borderColor:'var(--line)'}}>
         <div className="overflow-x-auto">
          <table className="w-full text-sm">
            <thead>
              <tr style={{background:'rgba(201,162,75,.10)'}}>
                <th className="text-left font-semibold px-4 py-2.5" style={{color:'var(--text-muted-c)'}}>Room #</th>
                <th className="text-left font-semibold px-4 py-2.5" style={{color:'var(--text-muted-c)'}}>Hourly rate (₱)</th>
                <th className="text-left font-semibold px-4 py-2.5" style={{color:'var(--text-muted-c)'}}>Status</th>
                <th className="px-4 py-2.5"></th>
              </tr>
            </thead>
            <tbody>
              {rooms.map(r=>(
                <tr key={r.id} className="border-t" style={{borderColor:'var(--line)'}}>
                  <td className="px-4 py-2.5 font-semibold">{r.number}</td>
                  <td className="px-4 py-2.5">
                    <input type="number" defaultValue={r.rate} onBlur={e=>updateRoomRate(r, e.target.value)}
                      className="focus-ring w-24 px-2 py-1 rounded-md border bg-transparent outline-none tabular" style={{borderColor:'var(--line)'}}/>
                  </td>
                  <td className="px-4 py-2.5">
                    <span className={"px-2 py-0.5 rounded-full text-xs font-semibold " + (r.status==='occupied' ? "bg-[var(--occupied)]/20 text-[var(--occupied-bright)]" : "bg-[var(--vacant)]/20 text-[var(--vacant-bright)]")}>
                      {r.status==='occupied' ? 'Occupied' : 'Vacant'}
                    </span>
                  </td>
                  <td className="px-4 py-2.5 text-right">
                    <button onClick={()=>removeRoom(r)} className="focus-ring p-1.5 rounded-md hover:bg-[var(--overdue)]/20 text-[var(--overdue-bright)]"><TrashIcon size={15}/></button>
                  </td>
                </tr>
              ))}
              <tr className="border-t" style={{borderColor:'var(--line)'}}>
                <td className="px-4 py-2.5">
                  <input value={newRoom.number} onChange={e=>setNewRoom(n=>({...n, number:e.target.value}))} placeholder="e.g. 111"
                    className="focus-ring w-24 px-2 py-1 rounded-md border bg-transparent outline-none" style={{borderColor:'var(--line)'}}/>
                </td>
                <td className="px-4 py-2.5">
                  <input type="number" value={newRoom.rate} onChange={e=>setNewRoom(n=>({...n, rate:e.target.value}))}
                    className="focus-ring w-24 px-2 py-1 rounded-md border bg-transparent outline-none tabular" style={{borderColor:'var(--line)'}}/>
                </td>
                <td></td>
                <td className="px-4 py-2.5 text-right">
                  <button onClick={addRoom} className="focus-ring inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white text-xs font-bold">
                    <PlusIcon size={13}/> Add Room
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
         </div>
        </div>
      </section>

      <section>
        <h3 className="font-display text-lg font-semibold mb-3">System settings</h3>
        <div className="grid sm:grid-cols-2 gap-4 max-w-2xl">
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Property name</label>
            <input value={form.innName} onChange={e=>setForm(f=>({...f, innName:e.target.value}))}
              className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none" style={{borderColor:'var(--line)'}}/>
          </div>
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Tagline</label>
            <input value={form.tagline||''} onChange={e=>setForm(f=>({...f, tagline:e.target.value}))}
              className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none" style={{borderColor:'var(--line)'}}/>
          </div>
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Default hourly rate (₱)</label>
            <input type="number" value={form.defaultRate} onChange={e=>setForm(f=>({...f, defaultRate:Number(e.target.value)}))}
              className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none tabular" style={{borderColor:'var(--line)'}}/>
          </div>
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Tax rate (%)</label>
            <input type="number" value={form.taxRate} onChange={e=>setForm(f=>({...f, taxRate:Number(e.target.value)}))}
              className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none tabular" style={{borderColor:'var(--line)'}}/>
          </div>
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Weekly report recipient email</label>
            <input type="email" value={form.ownerEmail} onChange={e=>setForm(f=>({...f, ownerEmail:e.target.value}))}
              className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none" style={{borderColor:'var(--line)'}}/>
          </div>
          <div className="sm:col-span-2">
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Additional recipients</label>
            <div className="mt-1 flex flex-col sm:flex-row gap-2">
              <input type="email" value={newRecipient} onChange={e=>setNewRecipient(e.target.value)}
                onKeyDown={e=>{ if(e.key==='Enter'){ e.preventDefault(); addRecipient(); } }}
                placeholder="another.email@example.com"
                className="focus-ring flex-1 px-3 py-2 rounded-lg border bg-transparent outline-none" style={{borderColor:'var(--line)'}}/>
              <button type="button" onClick={addRecipient}
                className="focus-ring shrink-0 flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white text-sm font-bold">
                <PlusIcon size={14}/> Add
              </button>
            </div>
            {(form.recipientEmails||[]).length>0 && (
              <div className="mt-2 flex flex-wrap gap-2">
                {form.recipientEmails.map(email=>(
                  <span key={email} className="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full border text-xs font-semibold" style={{borderColor:'var(--line)'}}>
                    {email}
                    <button type="button" onClick={()=>removeRecipient(email)} className="focus-ring p-0.5 rounded-full hover:bg-[var(--overdue)]/20 text-[var(--overdue-bright)]">
                      <XIcon size={12}/>
                    </button>
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
        <button onClick={saveSettings}
          className="focus-ring mt-4 flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white font-semibold text-sm">
          <CheckIcon size={16}/> Save Settings
        </button>
      </section>
    </div>
  );
}

/* ============================== OWNER DASHBOARD ============================== */
function OwnerDashboard({ dbApi, pushToast }){
  const [tab, setTab] = useState('ledger');
  const tabs = [
    { id:'ledger', label:'Master Ledger', icon: ListIcon },
    { id:'reports', label:'Reports & Export', icon: SheetIcon },
    { id:'admin', label:'Admin Settings', icon: SettingsIcon },
  ];
  return (
    <div>
      <div className="flex gap-1.5 mb-6 border-b" style={{borderColor:'var(--line)'}}>
        {tabs.map(t=>{
          const Active = tab===t.id;
          const Ic = t.icon;
          return (
            <button key={t.id} onClick={()=>setTab(t.id)}
              className={"focus-ring flex items-center gap-1.5 px-4 py-2.5 text-sm font-semibold border-b-2 -mb-px transition-colors " +
                (Active ? "border-[var(--brass-bright)] text-[var(--brass-bright)]" : "border-transparent hover:text-[var(--brass-bright)]")}
              style={{color: Active ? undefined : 'var(--text-muted-c)'}}>
              <Ic size={15}/> {t.label}
            </button>
          );
        })}
      </div>
      {tab==='ledger' && <Ledger dbApi={dbApi} pushToast={pushToast}/>}
      {tab==='reports' && <Reports dbApi={dbApi} pushToast={pushToast}/>}
      {tab==='admin' && <AdminSettings dbApi={dbApi} pushToast={pushToast}/>}
    </div>
  );
}

/* ============================== HEADER ============================== */
function Header({ view, setView, innName, role, onLogout, theme, toggleTheme }){
  const now = useNow(1000);
  return (
    <header style={{ background:'var(--header-bg)', borderColor:'var(--line)' }} className="border-b sticky top-0 z-40">
      <div className="max-w-7xl mx-auto px-5 py-2.5 flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-2 shrink-0">
          <img src={LOGO_DATA_URI} alt="" className="h-9 sm:h-11 w-auto select-none pointer-events-none shrink-0" draggable="false"/>
          <div className="font-display text-base sm:text-lg font-bold leading-tight whitespace-nowrap" style={{color:'var(--brass)'}}>{innName}</div>
        </div>

        {role==='owner' ? (
          <nav className="flex items-center gap-1 rounded-full p-1 shrink-0" style={{background:'var(--nav-pill)'}}>
            <button onClick={()=>setView('frontdesk')}
              className={"focus-ring flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-colors " +
                (view==='frontdesk' ? "bg-[var(--brass)] text-white" : "")}
              style={ view==='frontdesk' ? {} : {color:'var(--nav-pill-text)'} }>
              <KeyIcon size={15}/> Front Desk
            </button>
            <button onClick={()=>setView('owner')}
              className={"focus-ring flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-colors " +
                (view==='owner' ? "bg-[var(--brass)] text-white" : "")}
              style={ view==='owner' ? {} : {color:'var(--nav-pill-text)'} }>
              <SettingsIcon size={15}/> Owner Dashboard
            </button>
          </nav>
        ) : (
          <div className="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-semibold" style={{background:'var(--nav-pill)', color:'var(--nav-pill-text)'}}>
            <KeyIcon size={15}/> Front Desk
          </div>
        )}

        <div className="flex items-center gap-3">
          <div className="hidden sm:flex items-center gap-2 text-sm tabular" style={{color:'var(--text-muted-c)'}}>
            <ClockIcon size={15}/>{fmtClock(now)}
          </div>
          <button onClick={toggleTheme} title="Toggle day / night mode"
            className="focus-ring p-2 rounded-full border" style={{borderColor:'var(--line)', color:'var(--text-muted-c)'}}>
            {theme==='dark' ? <SunIcon size={15}/> : <MoonIcon size={15}/>}
          </button>
          <button onClick={onLogout} title="Log out"
            className="focus-ring flex items-center gap-1.5 px-3 py-2 rounded-full border text-sm font-semibold" style={{borderColor:'var(--line)', color:'var(--text-muted-c)'}}>
            <LogOutIcon size={15}/> <span className="hidden sm:inline">Log out</span>
          </button>
        </div>
      </div>
    </header>
  );
}
const KeyIcon = (p) => <Icon {...p}><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.6 12.4 8.9-8.9m-3.1 3.1 2.1 2.1m-5.2-.1 2 2"/></Icon>;
const SunIcon = (p) => <Icon {...p}><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19v2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2.5 12h2.4M19 12h2.4M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></Icon>;
const MoonIcon = (p) => <Icon {...p}><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></Icon>;
const LockIcon = (p) => <Icon {...p}><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></Icon>;

/* ============================== LANDING / LOGIN ============================== */
function LandingPage({ innName, tagline, onFrontDesk, onOwnerLogin, theme, toggleTheme }){
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [ownerOpen, setOwnerOpen] = useState(false);

  const submitOwner = (e) => {
    e.preventDefault();
    if(username.trim()===OWNER_CREDENTIALS.username && password===OWNER_CREDENTIALS.password){
      setError('');
      onOwnerLogin();
    } else {
      setError('Incorrect username or password.');
    }
  };

  return (
    <div className="min-h-screen flex flex-col items-center justify-center px-5 py-10 relative" style={{ background:'var(--bg)', color:'var(--text)' }}>
      <button onClick={toggleTheme}
        className="focus-ring absolute top-5 right-5 p-2.5 rounded-full border" style={{borderColor:'var(--line)'}}>
        {theme==='dark' ? <SunIcon size={17}/> : <MoonIcon size={17}/>}
      </button>

      <div className="w-full max-w-md text-center anim-rise">
        <img src={LOGO_DATA_URI} alt={innName + " logo"} className="mx-auto w-64 sm:w-72 select-none pointer-events-none" draggable="false"/>
        <h1 className="font-display text-4xl sm:text-5xl font-bold -mt-2" style={{color:'var(--brass)'}}>{innName}</h1>
        {tagline && <p className="mt-1 text-sm font-semibold tracking-wide" style={{color:'var(--text-muted-c)'}}>{tagline}</p>}

        <div className="mt-10 grid gap-4">
          <button onClick={onFrontDesk}
            className="focus-ring w-full flex items-center gap-4 rounded-2xl border-2 p-5 text-left transition-all hover:-translate-y-0.5"
            style={{ borderColor:'var(--line)', background:'var(--panel)' }}>
            <div className="p-3 rounded-xl" style={{background:'rgba(184,66,15,.12)', color:'var(--brass)'}}><KeyIcon size={24}/></div>
            <div className="flex-1 font-display text-lg font-semibold">Front Desk</div>
            <ChevronR size={20} style={{color:'var(--text-muted-c)'}}/>
          </button>

          {!ownerOpen ? (
            <button onClick={()=>setOwnerOpen(true)}
              className="focus-ring w-full flex items-center gap-4 rounded-2xl border-2 p-5 text-left transition-all hover:-translate-y-0.5"
              style={{ borderColor:'var(--line)', background:'var(--panel)' }}>
              <div className="p-3 rounded-xl" style={{background:'rgba(184,66,15,.12)', color:'var(--brass)'}}><SettingsIcon size={24}/></div>
              <div className="flex-1 font-display text-lg font-semibold">Owner</div>
              <ChevronR size={20} style={{color:'var(--text-muted-c)'}}/>
            </button>
          ) : (
            <form onSubmit={submitOwner} className="rounded-2xl border-2 p-5 text-left anim-rise" style={{ borderColor:'var(--line)', background:'var(--panel)' }}>
              <div className="flex items-center gap-2 mb-3">
                <div className="p-2 rounded-lg" style={{background:'rgba(184,66,15,.12)', color:'var(--brass)'}}><LockIcon size={16}/></div>
                <div className="font-display text-base font-semibold">Owner sign-in</div>
              </div>
              <div className="mb-3 text-xs rounded-lg px-3 py-2 border" style={{borderColor:'var(--brass)', color:'var(--brass)', background:'rgba(184,66,15,.08)'}}>
                Temporary access — username <strong>owner</strong>, password <strong>123</strong>
              </div>
              <div className="space-y-3">
                <input autoFocus value={username} onChange={e=>setUsername(e.target.value)} placeholder="Username"
                  className="focus-ring w-full px-3 py-2.5 rounded-lg border bg-transparent outline-none text-sm" style={{borderColor:'var(--line)'}}/>
                <input type="password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="Password"
                  className="focus-ring w-full px-3 py-2.5 rounded-lg border bg-transparent outline-none text-sm" style={{borderColor:'var(--line)'}}/>
              </div>
              {error && <div className="mt-2 text-sm text-[var(--overdue-bright)] flex items-center gap-1.5"><AlertIcon size={14}/>{error}</div>}
              <div className="mt-4 flex gap-2">
                <button type="button" onClick={()=>{ setOwnerOpen(false); setError(''); }}
                  className="focus-ring flex-1 px-4 py-2.5 rounded-lg border text-sm font-semibold" style={{borderColor:'var(--line)'}}>Cancel</button>
                <button type="submit"
                  className="focus-ring flex-1 px-4 py-2.5 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white text-sm font-bold">Sign In</button>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
}

/* ============================== ROOT APP ============================== */
function safeGet(key){ try{ return localStorage.getItem(key); }catch(e){ return null; } }
function safeSet(key, val){ try{ localStorage.setItem(key, val); }catch(e){ /* noop */ } }
function safeRemove(key){ try{ localStorage.removeItem(key); }catch(e){ /* noop */ } }

function App(){
  const { push: pushToast, view: toastView } = useToasts();
  const dbApi = useInnDb(pushToast);
  const [view, setView] = useState('frontdesk');
  const [role, setRole] = useState(()=> safeGet('mamela_role'));
  const [theme, setTheme] = useState(()=> safeGet('mamela_theme') || 'light');

  useEffect(()=>{
    document.documentElement.setAttribute('data-theme', theme);
    safeSet('mamela_theme', theme);
  },[theme]);

  const toggleTheme = () => setTheme(t => t==='dark' ? 'light' : 'dark');

  const handleFrontDesk = () => { setRole('frontdesk'); setView('frontdesk'); safeSet('mamela_role','frontdesk'); };
  const handleOwnerLogin = () => { setRole('owner'); setView('frontdesk'); safeSet('mamela_role','owner'); pushToast('Signed in as owner.'); };
  const handleLogout = () => { setRole(null); safeRemove('mamela_role'); };

  if(!role){
    return <LandingPage innName={dbApi.settings.innName} tagline={dbApi.settings.tagline}
      onFrontDesk={handleFrontDesk} onOwnerLogin={handleOwnerLogin}
      theme={theme} toggleTheme={toggleTheme}/>;
  }

  const effectiveView = role==='owner' ? view : 'frontdesk';

  return (
    <div className="min-h-screen" style={{ background:'var(--bg)', color:'var(--text)' }}>
      <Header view={effectiveView} setView={setView} innName={dbApi.settings.innName}
        role={role} onLogout={handleLogout} theme={theme} toggleTheme={toggleTheme}/>
      <main className="max-w-7xl mx-auto px-5 py-6">
        {!dbApi.ready ? (
          <div className="py-24 text-center" style={{color:'var(--text-muted-c)'}}>Loading front desk…</div>
        ) : (
          effectiveView==='frontdesk'
            ? <FrontDesk dbApi={dbApi} pushToast={pushToast}/>
            : <OwnerDashboard dbApi={dbApi} pushToast={pushToast}/>
        )}
      </main>
      <div className="max-w-7xl mx-auto px-5 pb-6 text-xs" style={{color:'var(--text-muted-c)'}}>
        Data is saved in this browser's storage only (not shared across devices). For multi-device, real-time data, connect this app to Supabase.
      </div>
      {toastView}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App/>);
</script>
</body>
