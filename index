            </button>
          </div>
        ) : (
          <div className="text-sm" style={{color:'var(--text-muted-c)'}}>No active transaction found for this room.</div>
        )}
      </div>
    </Modal>
  );
}

/* ============================== DATE PICKER (calendar) ============================== */
function DatePicker({ value, onChange }){
  const [open, setOpen] = useState(false);
  const [viewMonth, setViewMonth] = useState(()=> new Date(value.getFullYear(), value.getMonth(), 1));

  useEffect(()=>{ if(open) setViewMonth(new Date(value.getFullYear(), value.getMonth(), 1)); },[open]);

  const firstWeekday = viewMonth.getDay();
  const daysInMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth()+1, 0).getDate();
  const today = new Date();
  const isSameDay = (a,b) => a && b && a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate();

  const cells = [];
  for(let i=0;i<firstWeekday;i++) cells.push(null);
  for(let d=1; d<=daysInMonth; d++) cells.push(d);

  const pick = (d) => {
    onChange(new Date(viewMonth.getFullYear(), viewMonth.getMonth(), d, value.getHours(), value.getMinutes()));
    setOpen(false);
  };

  return (
    <div>
      <button type="button" onClick={()=>setOpen(o=>!o)}
        className="focus-ring w-full flex items-center gap-2 px-3 py-2.5 rounded-lg border bg-transparent text-left text-sm sm:text-base"
        style={{borderColor:'var(--line)'}}>
        <CalendarIcon size={16} className="shrink-0" style={{color:'var(--brass)'}}/>
        <span className="tabular truncate">{value.toLocaleDateString('en-PH',{month:'short', day:'numeric', year:'numeric'})}</span>
      </button>
      {open && (
        <div className="anim-rise mt-2 w-full rounded-xl border p-3" style={{background:'var(--bg)', borderColor:'var(--line)'}}>
          <div className="flex items-center justify-between mb-2">
            <button type="button" onClick={()=>setViewMonth(m=>new Date(m.getFullYear(), m.getMonth()-1, 1))}
              className="focus-ring p-1.5 rounded-md hover:bg-black/10"><ChevronR size={16} style={{transform:'rotate(180deg)'}}/></button>
            <div className="font-display font-semibold text-sm">{viewMonth.toLocaleDateString('en-PH',{month:'long', year:'numeric'})}</div>
            <button type="button" onClick={()=>setViewMonth(m=>new Date(m.getFullYear(), m.getMonth()+1, 1))}
              className="focus-ring p-1.5 rounded-md hover:bg-black/10"><ChevronR size={16}/></button>
          </div>
          <div className="grid grid-cols-7 gap-1 text-center text-[11px] font-semibold mb-1" style={{color:'var(--text-muted-c)'}}>
            {['S','M','T','W','T','F','S'].map((d,i)=><div key={i}>{d}</div>)}
          </div>
          <div className="grid grid-cols-7 gap-1">
            {cells.map((d,i)=>{
              if(d===null) return <div key={i}/>;
              const cellDate = new Date(viewMonth.getFullYear(), viewMonth.getMonth(), d);
              const selected = isSameDay(cellDate, value);
              const isToday = isSameDay(cellDate, today);
              return (
                <button key={i} type="button" onClick={()=>pick(d)}
                  className={"focus-ring h-9 rounded-md text-sm font-semibold tabular transition-colors " +
                    (selected ? "bg-[var(--brass)] text-white" : isToday ? "border-2" : "hover:bg-black/10")}
                  style={ (!selected && isToday) ? {borderColor:'var(--brass)'} : {} }>
                  {d}
                </button>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}

/* ============================== TIME PICKER (scrollable wheel) ============================== */
function TimePicker({ value, onChange }){
  const [open, setOpen] = useState(false);
  const hourColRef = useRef(null);
  const minColRef = useRef(null);

  const h24 = value.getHours();
  const h12 = ((h24 % 12) || 12);
  const minute5 = Math.round(value.getMinutes()/5)*5 % 60;
  const ampm = h24 >= 12 ? 'PM' : 'AM';

  const hoursList = Array.from({length:12},(_,i)=>i+1);
  const minutesList = Array.from({length:12},(_,i)=>i*5);

  useEffect(()=>{
    if(!open) return;
    setTimeout(()=>{
      const hIdx = hoursList.indexOf(h12);
      const mIdx = minutesList.indexOf(minute5);
      if(hourColRef.current && hourColRef.current.children[hIdx]) hourColRef.current.children[hIdx].scrollIntoView({ block:'center' });
      if(minColRef.current && minColRef.current.children[mIdx]) minColRef.current.children[mIdx].scrollIntoView({ block:'center' });
    }, 20);
  },[open]);

  const setHour12 = (h) => {
    let newH24 = h % 12;
    if(ampm==='PM') newH24 += 12;
    onChange(new Date(value.getFullYear(), value.getMonth(), value.getDate(), newH24, value.getMinutes()));
  };
  const setMinute = (m) => onChange(new Date(value.getFullYear(), value.getMonth(), value.getDate(), h24, m));
  const setAmPm = (ap) => {
    let newH24 = h12 % 12;
    if(ap==='PM') newH24 += 12;
    onChange(new Date(value.getFullYear(), value.getMonth(), value.getDate(), newH24, value.getMinutes()));
  };

  return (
    <div>
      <button type="button" onClick={()=>setOpen(o=>!o)}
        className="focus-ring w-full flex items-center gap-2 px-3 py-2.5 rounded-lg border bg-transparent text-left tabular text-sm sm:text-base"
        style={{borderColor:'var(--line)'}}>
        <ClockIcon size={16} className="shrink-0" style={{color:'var(--brass)'}}/>
        <span>{pad2(h12)}:{pad2(minute5)} {ampm}</span>
      </button>
      {open && (
        <div className="anim-rise mt-2 rounded-xl border p-3" style={{background:'var(--bg)', borderColor:'var(--line)'}}>
          <div className="flex gap-2">
            <div ref={hourColRef} className="flex-1 h-36 overflow-y-auto snap-y snap-mandatory rounded-lg border" style={{borderColor:'var(--line)'}}>
              <div className="h-14"/>
              {hoursList.map(h=>(
                <button key={h} type="button" onClick={()=>setHour12(h)}
                  className={"focus-ring w-full snap-center text-center py-2.5 text-sm font-bold tabular " +
                    (h===h12 ? "bg-[var(--brass)] text-white" : "hover:bg-black/10")}>{pad2(h)}</button>
              ))}
              <div className="h-14"/>
            </div>
            <div ref={minColRef} className="flex-1 h-36 overflow-y-auto snap-y snap-mandatory rounded-lg border" style={{borderColor:'var(--line)'}}>
              <div className="h-14"/>
              {minutesList.map(m=>(
                <button key={m} type="button" onClick={()=>setMinute(m)}
                  className={"focus-ring w-full snap-center text-center py-2.5 text-sm font-bold tabular " +
                    (m===minute5 ? "bg-[var(--brass)] text-white" : "hover:bg-black/10")}>{pad2(m)}</button>
              ))}
              <div className="h-14"/>
            </div>
            <div className="flex flex-col gap-1.5 justify-center">
              {['AM','PM'].map(ap=>(
                <button key={ap} type="button" onClick={()=>setAmPm(ap)}
                  className={"focus-ring px-2.5 py-2.5 rounded-lg text-xs font-bold " +
                    (ap===ampm ? "bg-[var(--brass)] text-white" : "border")}
                  style={ ap===ampm ? {} : {borderColor:'var(--line)'} }>{ap}</button>
              ))}
            </div>
          </div>
          <button type="button" onClick={()=>setOpen(false)}
            className="focus-ring mt-2 w-full py-2 rounded-lg text-xs font-bold border" style={{borderColor:'var(--line)'}}>Done</button>
        </div>
      )}
    </div>
  );
}

/* ============================== CHECK-IN MODAL ============================== */
function CheckInModal({ open, mode, initialRooms, allRooms, existingRefs, existingTxns, defaultRate, onClose, onConfirm }){
  const isSchedule = mode === 'schedule';
  const [ref] = useState(()=> genReference(existingRefs));
  const [guestName, setGuestName] = useState('');
  const [roomIds, setRoomIds] = useState([]);
  const [hours, setHours] = useState(3);
  const [timeInDate, setTimeInDate] = useState(()=> new Date());
  const [paymentMethod, setPaymentMethod] = useState('Cash');
  const [amount, setAmount] = useState(0);
  const [amountTouched, setAmountTouched] = useState(false);
  const [error, setError] = useState('');

  useEffect(()=>{
    if(open) setRoomIds(initialRooms || []);
  },[open, initialRooms]);

  useEffect(()=>{
    if(!open) return;
    setGuestName(''); setHours(3); setTimeInDate(new Date());
    setPaymentMethod('Cash'); setAmountTouched(false); setError('');
  },[open]);

  const selectedRoomObjs = allRooms.filter(r=> roomIds.includes(r.id));
  const ratesSum = selectedRoomObjs.reduce((s,r)=> s + (Number(r.rate)||defaultRate), 0);
  const suggestedAmount = ratesSum * Number(hours||0);

  useEffect(()=>{
    if(!amountTouched) setAmount(suggestedAmount);
  }, [suggestedAmount, amountTouched]);

  const timeOutIso = useMemo(()=>{
    return new Date(timeInDate.getTime() + Number(hours||0)*3600000).toISOString();
  },[timeInDate, hours]);

  if(!open) return null;

  const findConflict = () => {
    const newStart = timeInDate.getTime();
    const newEnd = new Date(timeOutIso).getTime();
    for(const t of (existingTxns||[])){
      if(t.status!=='active' && t.status!=='scheduled') continue;
      const tStart = new Date(t.timeIn).getTime();
      const tEnd = new Date(t.timeOut).getTime();
      const overlaps = newStart < tEnd && tStart < newEnd;
      if(!overlaps) continue;
      const sharedRoom = (t.roomIds||[]).find(rid => roomIds.includes(rid));
      if(sharedRoom) return { room: sharedRoom, guestName: t.guestName, timeIn: t.timeIn, timeOut: t.timeOut };
    }
    return null;
  };

  const submit = () => {
    if(!guestName.trim()){ setError('Guest name is required.'); return; }
    if(roomIds.length===0){ setError('Select at least one room.'); return; }
    if(!hours || Number(hours) <= 0){ setError('Duration must be greater than zero.'); return; }
    const conflict = findConflict();
    if(conflict){
      setError(`Room ${conflict.room} is already booked for ${conflict.guestName} (${fmtDateTime(conflict.timeIn)} \u2013 ${fmtDateTime(conflict.timeOut)}). Pick a different room or time.`);
      return;
    }
    setError('');
    onConfirm({
      ref,
      guestName: guestName.trim(),
      roomIds,
      hours: Number(hours),
      timeIn: timeInDate.toISOString(),
      timeOut: timeOutIso,
      paymentMethod,
      totalAmount: Number(amount)||0,
      status: isSchedule ? 'scheduled' : 'active',
      createdAt: new Date().toISOString(),
    });
  };

  return (
    <Modal open={open} onClose={onClose} wide>
      <div className="flex-1 overflow-y-auto">
        <div className="px-5 sm:px-6 pt-5 sm:pt-6 pb-4 border-b flex items-start justify-between" style={{borderColor:'var(--line)'}}>
          <div>
            <div className="text-xs uppercase tracking-wide font-semibold" style={{color:'var(--text-muted-c)'}}>{isSchedule ? 'New Reservation' : 'New Check-In'}</div>
            <div className="font-display text-2xl font-semibold">{isSchedule ? 'Schedule a Booking' : 'Guest Registration'}</div>
          </div>
          <button onClick={onClose} className="focus-ring p-2 rounded-lg hover:bg-black/10"><XIcon size={18}/></button>
        </div>

        <div className="p-5 sm:p-6 space-y-5">
          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Reference Number</label>
            <div className="mt-1 font-display text-lg font-semibold tabular px-3 py-2 rounded-lg border" style={{borderColor:'var(--line)', background:'rgba(201,162,75,.08)'}}>{ref}</div>
          </div>

          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Guest Name</label>
            <input value={guestName} onChange={e=>setGuestName(e.target.value)} placeholder="Juan Dela Cruz"
                   className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none"
                   style={{borderColor:'var(--line)'}} />
          </div>

          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Room(s) Selected</label>
            {isSchedule && (
              <div className="mt-1 mb-2 text-xs" style={{color:'var(--text-muted-c)'}}>Any room can be booked ahead — double-check it's actually free for the scheduled date.</div>
            )}
            <div className="mt-2 flex flex-wrap gap-2">
              {allRooms.map(r=>{
                const active = roomIds.includes(r.id);
                const disabled = !isSchedule && r.status==='occupied' && !active;
                return (
                  <button key={r.id} type="button" disabled={disabled}
                    onClick={()=> setRoomIds(ids => active ? ids.filter(x=>x!==r.id) : [...ids, r.id])}
                    className={
                      "focus-ring px-3 py-1.5 rounded-full text-sm font-semibold border transition-colors " +
                      (active ? "bg-[var(--brass)] border-[var(--brass-bright)] text-white" :
                       disabled ? "opacity-30 cursor-not-allowed border-[var(--line)]" :
                       "border-[var(--line)] hover:border-[var(--brass-bright)]")
                    }>
                    {r.number}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Duration (hours)</label>
              <input type="number" min="1" value={hours} onChange={e=>setHours(e.target.value)}
                     className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none tabular"
                     style={{borderColor:'var(--line)'}} />
              <div className="mt-1.5 flex gap-1.5 flex-wrap">
                {[3,6,12,22,24].map(h=>(
                  <button key={h} type="button" onClick={()=>setHours(h)}
                    className="focus-ring text-xs px-2 py-1 rounded-md border hover:border-[var(--brass-bright)]"
                    style={{borderColor:'var(--line)'}}>{h}h</button>
                ))}
              </div>
            </div>
            <div>
              <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Payment Method</label>
              <select value={paymentMethod} onChange={e=>setPaymentMethod(e.target.value)}
                      className="focus-ring mt-1 w-full px-3 py-2 rounded-lg border bg-transparent outline-none"
                      style={{borderColor:'var(--line)'}}>
                {PAYMENT_METHODS.map(m=> <option key={m} value={m} style={{color:'#111'}}>{m}</option>)}
              </select>
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>{isSchedule ? 'Scheduled Date' : 'Date In'}</label>
              <div className="mt-1"><DatePicker value={timeInDate} onChange={setTimeInDate}/></div>
            </div>
            <div>
              <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>{isSchedule ? 'Scheduled Time' : 'Time In'}</label>
              <div className="mt-1"><TimePicker value={timeInDate} onChange={setTimeInDate}/></div>
            </div>
          </div>

          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Date &amp; Time Out (auto)</label>
            <div className="mt-1 w-full px-3 py-2.5 rounded-lg border tabular text-sm sm:text-base" style={{borderColor:'var(--line)', color:'var(--text-muted-c)'}}>
              {timeOutIso ? fmtDateTime(timeOutIso) : '—'}
            </div>
          </div>

          <div>
            <label className="text-xs font-semibold uppercase tracking-wide" style={{color:'var(--text-muted-c)'}}>Total Payment Amount</label>
            <div className="mt-1 relative">
              <span className="absolute left-3 top-1/2 -translate-y-1/2" style={{color:'var(--text-muted-c)'}}>₱</span>
              <input type="number" min="0" value={amount}
                     onChange={e=>{ setAmount(e.target.value); setAmountTouched(true); }}
                     className="focus-ring w-full pl-7 pr-3 py-2 rounded-lg border bg-transparent outline-none tabular"
                     style={{borderColor:'var(--line)'}} />
            </div>
            <div className="mt-1 text-xs" style={{color:'var(--text-muted-c)'}}>Suggested: {fmtMoney(suggestedAmount)} ({selectedRoomObjs.length} room{selectedRoomObjs.length===1?'':'s'} × {hours||0}h)</div>
          </div>

          {error && (
            <div className="flex items-center gap-2 text-sm text-[var(--overdue-bright)]"><AlertIcon size={16}/>{error}</div>
          )}

          <button onClick={submit}
            className="focus-ring w-full flex items-center justify-center gap-2 rounded-lg bg-[var(--brass)] hover:bg-[var(--brass-bright)] text-white font-bold py-3 transition-colors">
            {isSchedule ? <CalendarIcon size={18}/> : <LogInIcon size={18}/>} {isSchedule ? 'Save Reservation' : 'Confirm Check-In'}
          </button>
        </div>
      </div>
    </Modal>
  );
}

