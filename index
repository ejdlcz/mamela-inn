/* ============================== TOASTS ============================== */
function useToasts(){
  const [toasts, setToasts] = useState([]);
  const push = useCallback((msg, kind='success')=>{
    const id = uid();
    setToasts(t=>[...t, {id, msg, kind}]);
    setTimeout(()=> setToasts(t=>t.filter(x=>x.id!==id)), 3400);
  },[]);
  const view = (
    <div className="fixed bottom-5 right-5 z-[200] flex flex-col gap-2 items-end">
      {toasts.map(t=>(
        <div key={t.id} className={
          "anim-toast flex items-center gap-2 px-4 py-3 rounded-lg shadow-xl border text-sm font-medium " +
          (t.kind==='success' ? "bg-[var(--vacant)] border-[var(--vacant-bright)] text-white" :
           t.kind==='error' ? "bg-[var(--overdue)] border-[var(--overdue-bright)] text-white" :
           "bg-[var(--panel)] border-[var(--line)] text-[var(--text)]")
        }>
          {t.kind==='success' ? <CheckIcon size={16}/> : t.kind==='error' ? <AlertIcon size={16}/> : <SparkIcon size={16}/>}
          <span>{t.msg}</span>
        </div>
      ))}
    </div>
  );
  return { push, view };
}

/* ============================== DB HOOK ============================== */
const LS_ROOMS = 'mamela_rooms_v1';
const LS_TXNS = 'mamela_txns_v1';
const LS_SETTINGS = 'mamela_settings_v1';

function lsGetJSON(key, fallback){
  try{ const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; }
  catch(e){ return fallback; }
}
function lsSetJSON(key, value){
  try{ localStorage.setItem(key, JSON.stringify(value)); }catch(e){ /* storage unavailable */ }
}

function useInnDb(pushToast){
  const [ready, setReady] = useState(false);
  const [rooms, setRooms] = useState(DEFAULT_ROOMS);
  const [txns, setTxns] = useState([]);
  const [settings, setSettings] = useState(DEFAULT_SETTINGS);

  useEffect(()=>{
    setRooms(lsGetJSON(LS_ROOMS, DEFAULT_ROOMS));
    setTxns(lsGetJSON(LS_TXNS, []));
    setSettings({ ...DEFAULT_SETTINGS, ...lsGetJSON(LS_SETTINGS, {}) });
    setReady(true);
  },[]);

  const api = useMemo(()=>({
    ready, dbAvailable: true,
    rooms, txns, settings,

    async saveRoom(room){
      setRooms(rs=>{
        const idx = rs.findIndex(r=>r.id===room.id);
        const next = idx===-1 ? [...rs, room] : (()=>{ const c=[...rs]; c[idx]=room; return c; })();
        lsSetJSON(LS_ROOMS, next);
        return next;
      });
    },
    async deleteRoom(id){
      setRooms(rs=>{
        const next = rs.filter(r=>r.id!==id);
        lsSetJSON(LS_ROOMS, next);
        return next;
      });
    },
    async saveTxn(txn){
      setTxns(ts=>{
        const idx = ts.findIndex(t=>t.ref===txn.ref);
        const next = idx===-1 ? [txn, ...ts] : (()=>{ const c=[...ts]; c[idx]=txn; return c; })();
        lsSetJSON(LS_TXNS, next);
        return next;
      });
    },
    async saveSettings(next){
      setSettings(next);
      lsSetJSON(LS_SETTINGS, next);
    },
  }),[ready, rooms, txns, settings]);

  return api;
}

/* ============================== ROOM CARD ============================== */
function useNow(intervalMs=1000){
  const [now, setNow] = useState(new Date());
  useEffect(()=>{
    const t = setInterval(()=> setNow(new Date()), intervalMs);
    return ()=> clearInterval(t);
  },[intervalMs]);
  return now;
}

function RoomCard({ room, now, selectMode, selected, onToggleSelect, onOpen }){
  const isOccupied = room.status === 'occupied';
  let bgClasses, edgeShadow, statusText;
  let timeLabel = null;

  if(isOccupied){
    const msLeft = new Date(room.timeOut).getTime() - now.getTime();
    const { overdue, h, m } = remaining(msLeft);
    timeLabel = `${overdue ? 'Overdue by' : ''} ${h}h ${pad2(m)}m ${overdue ? '' : 'left'}`.replace(/\s+/g,' ').trim();
    if(overdue){
      bgClasses = "bg-[var(--overdue)] border-[var(--overdue-bright)] text-white";
      edgeShadow = "0 5px 0 #612420";
      statusText = 'Overdue';
    } else {
      bgClasses = "bg-[var(--occupied)] border-[var(--occupied-bright)] text-white";
      edgeShadow = "0 5px 0 #5A3A12";
      statusText = 'Occupied';
    }
  } else {
    bgClasses = "bg-[var(--vacant)] border-[var(--vacant-bright)] text-white";
    edgeShadow = "0 5px 0 #24432E";
    statusText = 'Vacant';
  }

  const handleClick = () => {
    if(selectMode && !isOccupied){ onToggleSelect(room.id); return; }
    onOpen(room);
  };

  return (
    <button
      onClick={handleClick}
      className={
        "key-tag focus-ring group relative rounded-2xl border-[3px] pt-8 pb-4 px-4 text-left transition-all duration-150 " +
        "hover:-translate-y-0.5 active:translate-y-1 " + bgClasses +
        (selected ? " ring-4 ring-[var(--brass-bright)] ring-offset-2 ring-offset-[var(--bg)]" : "")
      }
      style={{ minHeight: 'clamp(150px, 15vw, 200px)', boxShadow: edgeShadow + ", 0 10px 18px rgba(0,0,0,.28)" }}
      onMouseDown={(e)=>{ e.currentTarget.style.boxShadow = "0 1px 0 rgba(0,0,0,.3), 0 3px 8px rgba(0,0,0,.25)"; }}
      onMouseUp={(e)=>{ e.currentTarget.style.boxShadow = edgeShadow + ", 0 10px 18px rgba(0,0,0,.28)"; }}
      onMouseLeave={(e)=>{ e.currentTarget.style.boxShadow = edgeShadow + ", 0 10px 18px rgba(0,0,0,.28)"; }}
    >
      {selectMode && !isOccupied && (
        <span className={
          "absolute top-2.5 right-2.5 w-6 h-6 rounded-full border-2 flex items-center justify-center " +
          (selected ? "bg-white text-[var(--vacant)] border-white" : "border-white/70 text-transparent")
        }>
          <CheckIcon size={14}/>
        </span>
      )}

      <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/22 text-[11px] font-extrabold uppercase tracking-wider">
        {isOccupied ? <UsersIcon size={13}/> : <BedIcon size={13}/>}
        {statusText}
      </span>

      <div className="mt-2.5 font-display text-4xl font-bold tabular leading-none">{room.number}</div>

      {isOccupied ? (
        <div className="mt-3 space-y-1">
          <div className="text-sm font-semibold truncate">{room.guestName || 'Guest'}</div>
          <div className="flex items-center gap-1 text-xs font-bold tabular bg-black/18 rounded-md px-1.5 py-0.5 w-fit">
            <ClockIcon size={12}/> {timeLabel}
          </div>
        </div>
      ) : (
        <div className="mt-3 text-xs font-semibold opacity-90">₱{room.rate}/hr · tap to check in</div>
      )}
    </button>
  );
}

/* ============================== MODAL SHELL ============================== */
function Modal({ open, onClose, children, wide }){
  if(!open) return null;
  return (
    <div className="fixed inset-0 z-[150] flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm"
         onMouseDown={(e)=>{ if(e.target===e.currentTarget) onClose(); }}>
      <div className={"anim-rise w-full " + (wide ? "max-w-2xl" : "max-w-md") + " rounded-2xl border shadow-2xl overflow-hidden max-h-[92vh] flex flex-col"}
           style={{ background:'var(--panel)', borderColor:'var(--line)' }}>
        {children}
      </div>
    </div>
  );
}

/* ============================== GUEST INFO MODAL (occupied room) ============================== */
function GuestInfoModal({ room, txn, allRooms, onClose, onCheckout, onChangeRoom, onAddRoom }){
  const now = useNow(1000);
  const [mode, setMode] = useState(null); // null | 'change' | 'add'
  const [fromRoom, setFromRoom] = useState(null);
  const [toRoom, setToRoom] = useState(null);
  const [addRoomId, setAddRoomId] = useState(null);

  useEffect(()=>{ setMode(null); setFromRoom(null); setToRoom(null); setAddRoomId(null); }, [room && room.id]);

  if(!room) return null;
  const msLeft = txn ? new Date(txn.timeOut).getTime() - now.getTime() : 0;
  const { overdue, h, m } = remaining(msLeft);
  const vacantRooms = (allRooms||[]).filter(r=> r.status==='vacant');
  const currentRoomIds = txn ? (txn.roomIds||[]) : [];

  const confirmChange = () => {
    if(!fromRoom || !toRoom) return;
    onChangeRoom(txn, fromRoom, toRoom);
  };
  const confirmAdd = () => {
    if(!addRoomId) return;
    onAddRoom(txn, addRoomId);
    setMode(null); setAddRoomId(null);
  };

  return (
    <Modal open={!!room} onClose={onClose}>
      <div className="p-5 sm:p-6 overflow-y-auto" style={{color:'var(--text)'}}>
        <div className="flex items-start justify-between mb-4">
          <div>
            <div className="text-xs uppercase tracking-wide font-semibold" style={{color:'var(--text-muted-c)'}}>Room</div>
            <div className="font-display text-3xl font-semibold">{room.number}</div>
          </div>
          <button onClick={onClose} className="focus-ring p-2 rounded-lg hover:bg-black/10"><XIcon size={18}/></button>
        </div>

        {txn ? (
          <div className="space-y-4">
            <div className={"rounded-lg px-4 py-3 flex items-center gap-2 text-sm font-medium " +
