/* ============================== HELPERS ============================== */
const PHP = new Intl.NumberFormat('en-PH', { style:'currency', currency:'PHP', maximumFractionDigits:0 });
const fmtMoney = (n) => PHP.format(Number(n)||0);
const pad2 = (n) => String(n).padStart(2,'0');

function toLocalInputValue(d){
  const dt = new Date(d);
  return `${dt.getFullYear()}-${pad2(dt.getMonth()+1)}-${pad2(dt.getDate())}T${pad2(dt.getHours())}:${pad2(dt.getMinutes())}`;
}
function fromLocalInputValue(v){
  // treat as local time
  return new Date(v).toISOString();
}
function fmtDateTime(iso){
  if(!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleString('en-PH', { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' });
}
function fmtClock(d){
  return d.toLocaleTimeString('en-PH', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
}
function remaining(msLeft){
  const overdue = msLeft < 0;
  const abs = Math.abs(msLeft);
  const h = Math.floor(abs/3600000);
  const m = Math.floor((abs%3600000)/60000);
  return { overdue, h, m };
}
function rand4(){
  return String(Math.floor(1000 + Math.random()*9000));
}
function refPrefix(){
  const d = new Date();
  return `INN-${d.getFullYear()}${pad2(d.getMonth()+1)}${pad2(d.getDate())}`;
}
function genReference(existingRefs){
  let ref;
  let guard = 0;
  do {
    ref = `${refPrefix()}-${rand4()}`;
    guard++;
  } while(existingRefs.has(ref) && guard < 50);
  return ref;
}
function uid(){ return Math.random().toString(36).slice(2,10); }

function browserDownload(filename, data, mime){
  const blob = (data instanceof Blob) ? data : new Blob([data], { type: mime || 'application/octet-stream' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=> URL.revokeObjectURL(url), 2000);
}

// Scales room-button size with both viewport width (via vw) and how many rooms
// exist, so a handful of rooms don't look tiny/crowded on a wide desktop, and
// a long room list doesn't force huge buttons that need excess scrolling.
function roomGridColumns(roomCount){
  let min = 150, max = 210;
  if(roomCount > 24){ min = 105; max = 140; }
  else if(roomCount > 16){ min = 120; max = 160; }
  else if(roomCount > 10){ min = 135; max = 185; }
  else if(roomCount <= 6){ min = 170; max = 260; }
  return `repeat(auto-fill, minmax(clamp(${min}px, 11vw, ${max}px), 1fr))`;
}

