            <button
              onClick={()=>onCheckout(txn)}
              className="focus-ring w-full mt-2 flex items-center justify-center gap-2 rounded-lg bg-[var(--vacant)] hover:bg-[var(--vacant-bright)] text-white font-semibold py-3 transition-colors"
            >
